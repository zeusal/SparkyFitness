{
  "name": "sparkyfitness-design-system-figma",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "typecheck:preview": "tsc --noEmit -p tsconfig.preview.json",
    "build": "esbuild src/main.ts --bundle --outfile=code.js --target=es2017 --format=iife",
    "build:preview": "esbuild src/main-preview.ts --bundle --outfile=code.js --target=es2017 --format=iife",
    "test": "node scripts/run.mjs all",
    "test:preview": "node scripts/run.mjs preview"
  },
  "dependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
